# Copy to .env and fill in your values (never commit .env)

# API URLs
BASE_URL=https://api.redidial.ai
APP_URL=https://app.redidial.ai

# Google Sign-In (OAuth client IDs)
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
IOS_CLIENT_ID=

# Branding
DEFAULT_LOGO_URL=https://example.com/logo.png

# Twilio — server-side only; mobile app fetches tokens from your API
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
